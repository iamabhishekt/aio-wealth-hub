{
  "$schema": "https://raw.githubusercontent.com/nicepkg/tauri-schema/main/schema.json",
  "productName": "AIO Wealth Hub",
  "version": "0.1.0",
  "identifier": "com.iamabhishekt.aiowealth",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --prefix ../frontend",
    "beforeBuildCommand": "npm run build --prefix ../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "AIO Wealth Hub",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "developmentTeam": "",
      "frameworks": ["LocalAuthentication"]
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}
